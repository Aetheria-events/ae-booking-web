# Cloudflare Pages and Netlify both read this file.
#
# Security headers only. The Content-Security-Policy is deliberately NOT set
# here: Vite inlines a small module preload shim, and the site posts to an Apps
# Script endpoint, so a CSP needs testing against a real deploy before it is
# enforced. Set it in the Cloudflare dashboard with a Report-Only run first,
# then move it in here once the console is clean. A wrong CSP breaks the booking
# form, which is the one thing that must never stop working.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000

# Hashed build assets never change, so they can be cached hard.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The app shell and the legal pages must revalidate, or a deploy never reaches
# someone who visited yesterday.
/index.html
  Cache-Control: public, max-age=0, must-revalidate
/404.html
  Cache-Control: public, max-age=0, must-revalidate
